PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_admin
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters


# Nodemailer — Gmail
# Generate App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
OWNER_EMAIL=your-email@gmail.com

# Optional HTTPS email provider. Recommended for Render Free because it blocks SMTP ports.
# Create an API key at resend.com; RESEND_FROM must be a sender/domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=

# Meta WhatsApp Cloud API (all values are required for automatic WhatsApp notifications)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE=923099369195
WHATSAPP_TEMPLATE_NAME=portfolio_inquiry
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0
